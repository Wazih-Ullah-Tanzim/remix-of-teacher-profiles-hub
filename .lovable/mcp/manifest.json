          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "tag": {
              "description": "Optional tag filter, e.g. 'Admissions', 'Event', 'Academics', 'Notice'.",
              "type": "string"
